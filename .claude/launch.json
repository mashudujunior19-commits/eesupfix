{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "eesup-web-static",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--directory",
        "app/build/web"
      ],
      "port": 8765
    },
    {
      "name": "eesup-web-dev",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd /d app && flutter run -d web-server --web-port 8766"
      ],
      "port": 8766
    }
  ]
}

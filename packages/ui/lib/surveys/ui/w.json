	('17148372-5bad-4559-8b76-f95f38ca3178', 'TVET Test 14 (Teamwork)', 'Duration: 15 mins', '[{"type":"Multiple Choice","comment":null,""options":[{""option":"Keep quiet and observe.","option_id":1,""is_correct":false},{""option":"Dominate the conversation with your ideas.","option_id":2,""is_correct":false},{""option":"Actively contribute, encourage others to share their ideas, and build on them.","option_id":3,""is_correct":true},{""option":"Only contribute if directly asked for input.","option_id":4,""is_correct":false}],""question":"Scenario 1: Teamwork \nImagine you are part of a team tasked with developing a new product for your company. Answer the following multiple-choice questions based on your collaborative working style and your contributions to fostering a positive and productive team environment.\n\nQuestion : Your team is brainstorming ideas for the new product. What is your role in the brainstorming session?","image_url":null,""slider_max":null,""slider_min":null,""is_required":true,""num_ratings":null,""question_id":1,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Ignore the conflict and hope it resolves itself.","option_id":1,""is_correct":false},{""option":"Criticize the conflicting parties in a team meeting.","option_id":2,""is_correct":false},{""option":"Facilitate a constructive discussion to understand perspectives and find common ground.","option_id":3,""is_correct":true},{""option":"Escalate the conflict to higher management without attempting resolution.","option_id":4,""is_correct":false}],""question":"A disagreement arises within the team regarding the product\'s design. How do you address the conflict?","image_url":null,""slider_max":null,""slider_min":null,""is_required":true,""num_ratings":null,""question_id":2,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Use the tool solely for task updates.","option_id":1,""is_correct":false},{""option":"Share memes and jokes to lighten the mood.","option_id":2,""is_correct":false},{""option":"Encourage open communication, provide constructive feedback, and celebrate achievements.","option_id":3,""is_correct":true},{""option":"Communicate only through private messages to avoid public interaction.","option_id":4,""is_correct":false}],""question":"Your team is communicating through a project management tool. How do you ensure effective and positive communication?","image_url":null,""slider_max":null,""slider_min":null,""is_required":true,""num_ratings":null,""question_id":3,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Keep it to yourself; they are just doing their job.","option_id":1,""is_correct":false},{""option":"Give public recognition during team meetings.","option_id":2,""is_correct":true},{""option":"Acknowledge privately, but do not make it a big deal.","option_id":3,""is_correct":false},{""option":"Downplay their efforts to avoid jealousy within the team.","option_id":4,""is_correct":false}],""question":"A team member consistently goes above and beyond in their tasks. How do you acknowledge their contributions?","image_url":null,""slider_max":null,""slider_min":null,""is_required":true,""num_ratings":null,""question_id":4,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Resist any changes to your assigned tasks.","option_id":1,""is_correct":false},{""option":"Complain about the additional workload.","option_id":2,""is_correct":false},{""option":"Adapt willingly and offer assistance to others affected by the changes.","option_id":3,""is_correct":true},{""option":"Only contribute if directly assigned new tasks.","option_id":4,""is_correct":false}],""question":"The project encounters unexpected challenges, requiring a shift in team responsibilities. How do you respond?","image_url":null,""slider_max":null,""slider_min":null,""is_required":true,""num_ratings":null,""question_id":5,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Side with the Architect and focus on realistic, achievable features. ","option_id":1,""is_correct":false},{""option":"Champion the Visionary\'s idea without considering its feasibility. ","option_id":2,""is_correct":false},{""option":"Suggest a smaller-scale VR element, encouraging collaboration between both viewpoints. ","option_id":3,""is_correct":true},{""option":"Ignore the debate and focus on your assigned tasks.","option_id":4,""is_correct":false}],""question":"Scenario 2: Teamwork \nYou\'re a software developer thrown into a whirlwind project - building a groundbreaking app to fight deforestation in the Amazon rainforest. Your team\'s a colorful mix:\nâ¢\tThe Visionary: A passionate environmentalist with innovative ideas but sometimes lacks technical expertise.\nâ¢\tThe Architect: A coding wizard who thrives on structure and loves writing perfect code but can be inflexible.\nâ¢\tThe Pragmatist: A seasoned developer who prioritizes realistic timelines and knows how to cut corners efficiently.\nâ¢\tThe Newbie: Eager to learn but still navigating the technical ropes and sometimes shy about voicing their ideas.\n\nThe Challenge: Merge everyone\'s strengths and overcome their quirks to build a user-friendly, impactful app, all within a tight deadline.\n\nQuestion : The Visionary proposes a stunning virtual reality feature to immerse users in the rainforest. The Architect scoffs, claiming it\'s impossible within the timeframe. How do you respond? ","image_url":null,""slider_max":null,""slider_min":null,""is_required":true,""num_ratings":null,""question_id":6,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Tell the Pragmatist they\'re right and implement the simpler UI. ","option_id":1,""is_correct":false},{""option":"Dismiss the Newbie\'s concerns, claiming they lack experience. ","option_id":2,""is_correct":false},{""option":"Organize a team discussion to explore alternative solutions that satisfy both user experience and efficiency. ","option_id":3,""is_correct":true},{""option":"Ask your manager to decide between the conflicting suggestions.","option_id":4,""is_correct":false}],""question":"The Pragmatist suggests simplifying the app UI to meet the deadline. The Newbie feels this compromises user experience. What\'s your next move?","image_url":null,""slider_max":null,""slider_min":null,""is_required":true,""num_ratings":null,""question_id":7,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Defensively argue your approach and refuse to change your code. ","option_id":1,""is_correct":false},{""option":"Passively accept the feedback without actively engaging in discussion. ","option_id":2,""is_correct":false},{""option":"Ask clarifying questions to understand their concerns and explore collaborative improvements. ","option_id":3,""is_correct":true},{""option":"Politely ignore the feedback, claiming your code still works effectively.","option_id":4,""is_correct":false}],""question":"During a coding session, the Architect discovers your code deviates from their preferred style. How do you handle this constructive criticism?","image_url":null,""slider_max":null,""slider_min":null,""is_required":true,""num_ratings":null,""question_id":8,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Force a vote and implement the majority decision, even if some team members disagree. ","option_id":1,""is_correct":false},{""option":"Walk away from the discussion and work on your own tasks individually. ","option_id":2,""is_correct":false},{""option":"Propose brainstorming exercises or creative problem-solving techniques to find a consensus solution. ","option_id":3,""is_correct":true},{""option":"Delegate the decision-making to the team leader without offering your own suggestions.","option_id":4,""is_correct":false}],""question":"The team reaches a deadlock over a major design decision. How do you break the impasse?","image_url":null,""slider_max":null,""slider_min":null,""is_required":true,""num_ratings":null,""question_id":9,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Continue enjoying your pizza without acknowledging their isolation. ","option_id":1,""is_correct":false},{""option":" Invite them to join in but accept their refusal without further inquiry. ","option_id":2,""is_correct":false},{""option":"Gently inquire about their reason for not joining and make them feel welcome and included in the team celebrations. ","option_id":3,""is_correct":true},{""option":"Offer to bring them their own food separately in case they have dietary restrictions.","option_id":4,""is_correct":false}],""question":"After a long day of coding, the team celebrates a milestone by ordering pizza. You notice the Newbie isn\'t joining in. What do you do?","image_url":null,""slider_max":null,""slider_min":null,""is_required":true,""num_ratings":null,""question_id":10,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false}]"', '', '1', '', '', '', '15', '10', '', 'false', 'true', 'true', 'true', 'f75a818c-69eb-4372-a1f4-eef123d06a8a', 'true', 'true', 'Test'),

	('c67fa61a-41f4-4f04-b2cd-0e65a23bb8d7', 'TVET Test 1 (Logical)', 'This test will assess your ability to solve mathematical and logic word problems. You are permitted to use a calculator and a piece of paper and a pen.  There are 15 questions and you have 60 minutes to complete the test.', '[{"type":"Multiple Choice","comment":null,""options":[{""option":"Chris ","option_id":1,""is_correct":false},{""option":"Don ","option_id":2,""is_correct":false},{""option":"Jim ","option_id":3,""is_correct":false},{""option":"Tom","option_id":4,""is_correct":false},{""option":"None of the above","option_id":5,""is_correct":false}],""question":"1.\tChris loves the girl who is in love with Don. Jim loves the girl who loves the man who loves Gillian. Tom loves the girl who loves the man who loves Justine. Kim does not love Tom. Alice loves a man who does not love Kim. Who loves Justine?","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":1,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Al won","option_id":1,""is_correct":false},{""option":"George won","option_id":2,""is_correct":false},{""option":"It was a tie","option_id":3,""is_correct":false}],""question":"When Al and George ran a 100-meter race, Al won by five meters. So to give George a chance they raced again, but this time Al started five meters behind the starting line. Each man ran the race at the same speed as in the first race. What were the results of the second race? ","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":4,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"680","option_id":1,""is_correct":false},{""option":"860","option_id":2,""is_correct":false},{""option":"900","option_id":3,""is_correct":false},{""option":"1024","option_id":4,""is_correct":false},{""option":"None of the above","option_id":5,""is_correct":false}],""question":"A contractor estimated that one of his two bricklayers would take 9 hours to build a certain wall and the other 10 hours. When the two bricklayers worked together, however, 10 fewer bricks got laid per hour. With both men working on the job it took exactly 5 hours to build the wall. How many bricks did it contain? ","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":5,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"6","option_id":1,""is_correct":false},{""option":"7","option_id":2,""is_correct":false},{""option":"8","option_id":3,""is_correct":false},{""option":"9","option_id":4,""is_correct":false},{""option":"None of the above","option_id":5,""is_correct":false}],""question":"You have a can with four balls of different colors. Randomly, you draw two at a time, then paint the first ball to match the second what is the expected number of drawings before all balls are the same color? ","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":6,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"No","option_id":1,""is_correct":false},{""option":"Yes","option_id":2,""is_correct":false},{""option":"It is impossible to tell","option_id":3,""is_correct":false},{""option":"It would cost the same","option_id":4,""is_correct":false}],""question":"The New York City subway system buys wheels for the subway cars for 200 
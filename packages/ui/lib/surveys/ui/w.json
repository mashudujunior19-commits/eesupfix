	('9f62bc31-aff4-4a1c-8005-3419fd8794e8', 'TVET Test 7 (Empathy)', '', '[{"type":"Multiple Choice","comment":null,""options":[{""option":"Target only the largest community groups, assuming they represent the majority.","option_id":1,""is_correct":false},{""option":"Develop tailored outreach strategies for various community groups, acknowledging their unique needs.","option_id":2,""is_correct":true},{""option":"Delegate outreach to community leaders, assuming they understand the needs of their respective groups.","option_id":3,""is_correct":false},{""option":"Focus on groups that align with your personal background and experiences.","option_id":4,""is_correct":false}],""question":"Scenario 1: Empathy & Cultural Sensitivity\nYou are a coordinator for the Community Harmony Project at Unity Haven, aiming to foster inclusivity and understanding among diverse community members. Answer the following multiple-choice questions based on your respectful and understanding attitude towards diverse backgrounds and community needs.\n\nQuestion 1: You are tasked with reaching out to diverse community groups to involve them in the project. How do you approach this outreach?\n","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":1,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Ignore the differences, assuming they are not significant to the project.","option_id":1,""is_correct":false},{""option":"Schedule a separate meeting to discuss cultural differences and find common ground.","option_id":2,""is_correct":false},{""option":"Acknowledge the differences openly and work collaboratively to bridge the gap.","option_id":3,""is_correct":true},{""option":"Blame the misunderstanding on cultural differences without seeking resolution.","option_id":4,""is_correct":false}],""question":"During a project meeting, cultural differences lead to a misunderstanding. How do you address this situation?","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":2,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Make the decision independently, assuming it will benefit the majority.","option_id":1,""is_correct":false},{""option":"Consult a single community representative to make the decision.","option_id":2,""is_correct":false},{""option":"Facilitate a collaborative decision-making process, involving representatives from all affected community groups.","option_id":3,""is_correct":true},{""option":"Delay the decision until community groups reach a consensus among themselves.","option_id":4,""is_correct":false}],""question":"A key decision must be made that affects multiple community groups. How do you approach the decision-making process?","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":3,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Proceed with the event, assuming accessibility is not a major concern.","option_id":1,""is_correct":false},{""option":"Delegate accessibility considerations to a specific team member.","option_id":2,""is_correct":false},{""option":"Consult with individuals with disabilities to ensure the event is accessible to everyone.","option_id":3,""is_correct":true},{""option":"Cancel the event to avoid potential complications.","option_id":4,""is_correct":false}],""question":"A community event is planned, but it may not be accessible to individuals with disabilities. How do you address this issue?","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":4,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Dismiss the feedback, assuming it represents a minority opinion.","option_id":1,""is_correct":false},{""option":"Acknowledge the feedback but take no immediate action.","option_id":2,""is_correct":false},{""option":"Address the concerns openly, expressing a commitment to rectifying the oversight.","option_id":3,""is_correct":true},{""option":"Avoid engaging with the community group, fearing further negative feedback.","option_id":4,""is_correct":false}],""question":"Negative feedback arises from a community group that feels overlooked. How do you respond?","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":5,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Conduct surveys and hold meetings solely in English, excluding those with language barriers. ","option_id":1,""is_correct":false},{""option":"Organize focus groups translated into different languages, actively listening to concerns and suggestions. ","option_id":2,""is_correct":true},{""option":"Prioritize catering to the largest cultural group, neglecting the needs of smaller communities.","option_id":3,""is_correct":false},{""option":"Rely on assumptions and stereotypes about different cultures, failing to engage in open dialogue.","option_id":4,""is_correct":false}],""question":"Scenario 2: Empathy & Cultural Sensitivity\nYou\'re the newly appointed community liaison officer for Crossroads CafÃ©, a charming eatery nestled in a bustling, multicultural neighborhood. Crossroads aims to be a welcoming space for everyone, celebrating the diverse cuisines and customs of its patrons. But recently, tensions have arisen:\nâ¢\tLanguage Barriers: New immigrant families feel excluded due to limited English-language menus and interactions.\nâ¢\tDietary Restrictions: Vegan and gluten-free options are scarce, hindering inclusivity for people with specific dietary needs.\nâ¢\tAccessibility Concerns: The aging cafÃ© layout presents challenges for patrons with mobility limitations.\nâ¢\tCultural Clashes: Loud music and lively conversations from one cultural group create discomfort for others seeking a quieter atmosphere.\n\nQuestion 6: Your initial approach to understanding the diverse needs of the community is:","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":6,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Print menus in English only, claiming it\'s too expensive to translate into multiple languages. ","option_id":1,""is_correct":false},{""option":" Hire bilingual staff members and implement multilingual signage to improve communication and inclusivity. ","option_id":2,""is_correct":true},{""option":"Create separate dining areas for different cultural groups, potentially furthering segregation. ","option_id":3,""is_correct":false},{""option":"Ignore the issue altogether and hope communication difficulties simply \""resolve themselves.\""","option_id":4,""is_correct":false}],""question":"When addressing the language barrier issue, you:","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":7,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Dismissively claim allergies and dietary restrictions are \""trendy fads\"" and refuse to adapt the menu. ","option_id":1,""is_correct":false},{""option":"Introduce dedicated vegan and gluten-free sections on the menu, ensuring options for everyone.","option_id":2,""is_correct":true},{""option":"Increase portion sizes on existing dishes, assuming that\'s what all patrons desire. ","option_id":3,""is_correct":false},{""option":" Force everyone to conform to the majority\'s eating habits, disregarding individual preferences.","option_id":4,""is_correct":false}],""question":"To cater to diverse dietary needs, you:","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":8,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Downplay the issue and claim the cafÃ©\'s historic charm necessitates its current layout. ","option_id":1,""is_correct":false},{""option":"Collaborate with community members and accessibility experts to implement practical solutions like ramps and wider walkways. ","option_id":2,""is_correct":true},{""option":"Offer limited accommodations only to individuals who explicitly complain, making access conditional. ","option_id":3,""is_correct":false},{""option":"Blame patrons with disabilities for being \""inconvenient\"" and refuse to make any changes.","option_id":4,""is_correct":false}],""question":"When confronted about the accessibility concerns, you:","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":9,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Enforce strict silence within the cafÃ©, potentially alienating those who enjoy lively social spaces. ","option_id":1,""is_correct":false},{""option":"Dedicate specific times and areas for different preferences, allowing for a blend of atmospheres. ","option_id":2,""is_correct":true},{""option":"Impose a single cultural norm on the cafÃ©, disregarding the diverse backgrounds of the patrons. ","option_id":3,""is_correct":false},{""option":" Ignore the issue and hope the different groups eventually learn to tolerate each other\'s preferences.","option_id":4,""is_correct":false}],""question":"Question 5: To address the cultural clashes over music and ambiance, you:","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":10,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false}]"', '', '1', '', '', '', '30', '10', '100', 'false', 'true', 'true', 'true', 'e59fe20a-271b-466c-a3be-f7cb03f76b33', 'true', 'true', 'Test'),
	('6626d89d-d72b-4c62-8c16-def7a61bceb0', 'EESUplift Application template', '', '[{"type":"Multiple Choice","comment":null,""options":[{""option":"A","option_id":1,""is_correct":true},{""option":"B","option_id":2,""is_correct":false}],""question":"Question","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":1,""allow_recording":false,""media_file_type":"Image","slider_interval":null,""allow_multiple_files":false,""allow_multiple_selection":null}]"', '', '', '', '', '', '5', '1', '100', 'false', 'true', 'true', 'false', '', 'true', 'false', 'Test'),
	('d240e8a7-b8dc-4532-91e4-1b90ebc83c8d', 'TVET Test 10 (Work Ethic)', 'Duration: 15mins', '[{"type":"Multiple Choice","comment":null,""options":[{""option":"Panic and complain about the unrealistic deadline, feeling overwhelmed and unproductive. ","option_id":1,""is_correct":false},{""option":"Organize your tasks diligently, prioritize based on urgency and impact, and estimate completion times realistically. ","option_id":2,""is_correct":true},{""option":"Jump into coding fixes immediately, neglecting other crucial aspects of the project and potentially creating bottlenecks.","option_id":3,""is_correct":false},{""option":"Delegate everything to the more experienced team members, hoping they can handle the pressure without your involvement.","option_id":4,""is_correct":false}],""question":"Scenario 1: Motivation & Work Ethic\n\nCongratulations! You\'ve landed a coveted internship at Techtopia, a cutting-edge tech startup specializing in AI-powered healthcare solutions. Your first project? Assisting with the launch of \""PulseCheck,\"" a revolutionary app that predicts potential health risks with personalized advice.\nThe problem? Launch day is in two weeks, and the workload is overwhelming. Your team, a mix of seasoned veterans and enthusiastic newbies, needs a proactive and efficient problem solver to ensure a flawless launch.\n\nQuestion : Upon receiving a mountain of tasks - coding bug fixes, user interface design tweaks, and marketing materials revisions - your initial reaction is:","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":1,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Remain silent and hope someone else raises the issue, avoiding potential conflict. ","option_id":1,""is_correct":false},{""option":"Propose innovative solutions to improve the feature within the deadline, offering concrete suggestions and examples. ","option_id":2,""is_correct":true},{""option":"Suggest delaying the launch altogether until the feature is perfect, potentially causing financial repercussions. ","option_id":3,""is_correct":false},{""option":"Blame the assigned developer for the feature\'s lackluster state, creating tension and negativity within the team.","option_id":4,""is_correct":false}],""question":"During a team meeting, a critical feature seems under-developed and could jeopardize the user experience. You:","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":2,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Ignore the issue and hope it goes unnoticed, prioritizing meeting the deadline over user safety. ","option_id":1,""is_correct":false},{""option":"Immediately alert your supervisor and collaborate with the security team to fix the vulnerability before launch. ","option_id":2,""is_correct":true},{""option":" Document the issue but leave it to others to address, feeling unsure about your responsibility to raise the alarm. ","option_id":3,""is_correct":false},{""option":"Try to fix the vulnerability on your own without informing anyone, potentially making the situation worse.","option_id":4,""is_correct":false}],""question":"While working on your tasks, you discover a potential security vulnerability in the app that could compromise user data. Your response is:","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":3,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Rushing to complete remaining tasks at the last minute, leaving no room for error or unexpected problems. ","option_id":1,""is_correct":false},{""option":"Creating troubleshooting checklists and backup plans for potential technical issues, ensuring a smooth launch. ","option_id":2,""is_correct":true},{""option":"Disconnecting from work communication channels, avoiding potential stress and focusing on personal relaxation. ","option_id":3,""is_correct":false},{""option":"Delegating customer support to others without offering guidance or backup in case of overwhelming inquiries.","option_id":4,""is_correct":false}],""question":"Launch day arrives. You anticipate last-minute glitches and challenges. Your proactive preparation includes:","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":4,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Boast about your individual contributions and take sole credit for the success, downplaying the team\'s efforts. ","option_id":1,""is_correct":false},{""option":"Express sincere gratitude to the team and supervisors, celebrating the collective achievement and shared commitment. ","option_id":2,""is_correct":true},{""option":"Use the success to immediately request a promotion or additional responsibilities without considering team dynamics. ","option_id":3,""is_correct":false},{""option":"Downplay your involvement and focus on the next project, lacking enthusiasm for celebrating the accomplishment.","option_id":4,""is_correct":false}],""question":"After a successful launch, PulseCheck exceeds download expectations and receives positive user feedback. Your manager commends the team\'s hard work. You:","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":5,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Wait for instructions before taking any action.","option_id":1,""is_correct":false},{""option":"Initiate a kick-off meeting to establish goals, timelines, and individual responsibilities.","option_id":2,""is_correct":true},{""option":"Begin working independently without consulting team members.","option_id":3,""is_correct":false},{""option":"Express concerns about the workload before commencing work.","option_id":4,""is_correct":false}],""question":"Scenario 2:\nYou are a team lead at Peak Innovations, a company known for its commitment to excellence. Answer the following multiple-choice questions based on your proactive and diligent work attitude, focusing on meeting deadlines and exceeding expectations.\n\nQuestion : A new project is assigned to your team. How do you approach the initial planning phase?\n","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":6,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Work steadily without setting personal deadlines.","option_id":1,""is_correct":false},{""option":"Set personal deadlines for each task, ensuring alignment with the overall project timeline.","option_id":2,""is_correct":true},{""option":"Rely on reminders from colleagues to stay on track.","option_id":3,""is_correct":false},{""option":"Procrastinate until the deadline approaches to maximize efficiency.","option_id":4,""is_correct":false}],""question":"The project has a firm deadline. How do you manage your tasks to ensure timely completion?","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":7,""allow_recording":false,""media_file_type":"Image",
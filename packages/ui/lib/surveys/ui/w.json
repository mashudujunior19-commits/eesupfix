ny people are computer savvy you are not very familiar with computers.","option_id":3,""is_correct":false}],""question":"You recently bought a new computer and are having trouble getting t to work properly so you contact the computer manufacturerâs technical support line. Once on the phone, the tech support assistant is patronizing you for your lack of technical knowledge. You:","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":17,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Say nothing for fear of losing a friend.","option_id":1,""is_correct":false},{""option":"Take the opportunity to criticize him as well.","option_id":2,""is_correct":false},{""option":"Discuss how you feel but back off if it looks like you will start an argument. ","option_id":3,""is_correct":false}],""question":"A good friend of yours starts criticizing you. You:","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":18,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Stop talking.","option_id":1,""is_correct":false},{""option":"Start talking louder to get his or her attention.","option_id":2,""is_correct":false},{""option":"Mention to him or her that he or she appears as though they are distracted.","option_id":3,""is_correct":false}],""question":"You are on a date and are talking about yourself, it appears that your date isnât listening to what you are saying, so you:","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":19,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Go out without mentioning youâd rather stay home.","option_id":1,""is_correct":false},{""option":"Tell your spouse you want to be alone.","option_id":2,""is_correct":false},{""option":"Tell your spouse youâd rather stay home and explain why you feel this way. ","option_id":3,""is_correct":false}],""question":"You return home from work and your spouse asks if you want to go out for the evening, but you would rather stay in. You:","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":20,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Usually just listen.","option_id":1,""is_correct":false},{""option":"Always like to control the conversation.","option_id":2,""is_correct":false},{""option":"Participate in the conversation when you feel you have something valuable to add. ","option_id":3,""is_correct":false}],""question":"When you are having dinner with your family you:","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":21,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Buy him the toy anyway so he wonât get mad at you.","option_id":1,""is_correct":false},{""option":"Buy the toy then try and return it to the store in a few weeks and hope he doesnât notice.","option_id":2,""is_correct":false},{""option":"Explain to him that you cannot afford the toy and that he should try and get by with the ones he already has.","option_id":3,""is_correct":false}],""question":"Your child asks you for an expensive toy. You cannot afford it and your
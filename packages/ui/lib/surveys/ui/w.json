	('f75a818c-69eb-4372-a1f4-eef123d06a8a', 'TVET Test 13 (Project Management)', 'DUration: 15 mins', '[{"type":"Multiple Choice","comment":null,""options":[{""option":"Extend the project timeline.","option_id":1,""is_correct":false},{""option":"Reevaluate and adjust project priorities.","option_id":2,""is_correct":true},{""option":"Delegate the additional tasks to team members.","option_id":3,""is_correct":false},{""option":"Continue with the original plan.","option_id":4,""is_correct":false}],""question":"Scenario1: Project Management \nYou are the project manager for a critical business project. The deadline is approaching, and various tasks need careful planning, organization, and execution to ensure successful completion. Answer the following multiple-choice questions based on the scenario.\n\nQuestion : The project scope and objectives are well-defined, but additional tasks emerge. What should the employee prioritize to accommodate these changes?","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":1,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Assign tasks randomly to build team versatility.","option_id":1,""is_correct":false},{""option":"Assign tasks based on team members\' strengths and expertise.","option_id":2,""is_correct":true},{""option":"Assign all tasks to the most experienced team member.","option_id":3,""is_correct":false},{""option":"Let team members choose tasks themselves.","option_id":4,""is_correct":false}],""question":"Team members have various skills, and specific tasks require specialized expertise. How should the employee approach task assignment?\n\n","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":2,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Ignore the delay and hope to catch up later.","option_id":1,""is_correct":false},{""option":"Inform stakeholders about the potential delay and propose a revised timeline.","option_id":2,""is_correct":true},{""option":"Assign additional resources without analyzing the cause of the delay.","option_id":3,""is_correct":false},{""option":"Shift focus to other tasks and revisit the delayed task later.","option_id":4,""is_correct":false}],""question":"A critical task is taking longer than expected, jeopardizing the project timeline. What action should the employee take?","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":3,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Prioritize tasks based on personal preference.","option_id":1,""is_correct":false},{""option":"Address tasks in random order.","option_id":2,""is_correct":false},{""option":"Use a task management tool to prioritize and schedule tasks.","option_id":3,""is_correct":true},{""option":"Complete tasks as they arise without a predefined plan.","option_id":4,""is_correct":false}],""question":"The employee is juggling multiple project tasks with varying deadlines. What strategy would be most effective in ensuring all tasks are completed on time?","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":4,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Panic and stress about the situation.","option_id":1,""is_correct":false},{""option":"Seek advice from team members before taking any action.","option_id":2,""is_correct":false},{""option":"Analyze the challenges, identify possible solutions, and take proactive steps.","option_id":3,""is_correct":true},{""option":"Ignore the challenges and hope they resolve themselves.","option_id":4,""is_correct":false}],""question":"Unexpected challenges have arisen, impacting the project\'s progress. What should the employee do first?","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":5,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Instagram contest, Influencer outreach, Social media posts, Press release, Media outreach ","option_id":1,""is_correct":false},{""option":"Press release, Media outreach, Instagram contest, Influencer outreach, Social media posts","option_id":2,""is_correct":true},{""option":"Social media posts, Instagram contest, Influencer outreach, Press release, Media outreach ","option_id":3,""is_correct":false},{""option":"Influencer outreach, Instagram contest, Social media posts, Press release, Media outreach","option_id":4,""is_correct":false}],""question":"Scenario 2: Project Management\nYou\'ve just landed your dream job as a marketing associate at \""Buzzworthy Brands,\"" a trendy beverage company known for its innovative drink flavors and vibrant social media presence. Today\'s agenda? Launching their newest creation, \""Mango Mojito Madness,\"" in a big way! Your manager throws a mountain of tasks your way:\n1. Social Media Blitz: Plan and schedule catchy posts announcing the \""Mango Mojito Madness\"" launch across Instagram, Facebook, and Twitter. These posts should:\nâ¢\tCatch attention: Use engaging visuals and witty captions.\nâ¢\tTarget the right audience: Gear your content towards young adults and party enthusiasts.\nâ¢\tBoost engagement: Encourage comments, shares, and user-generated content using clever hashtags.\n2. Influencer Frenzy: Secure two social media influencers with at least 20,000 followers each to promote \""Mango Mojito Madness\"" through eye-catching photos and videos.\n3. Contest Craze: Create a fun and interactive Instagram contest encouraging user-generated content featuring \""Mango Mojito Madness.\"" The prize? A year\'s supply of Buzzworthy Brands beverages!\n4. Media Magic: Draft a press release announcing the launch to local news outlets and food blogs. This should highlight the unique flavor and appeal of \""Mango Mojito Madness.\""\n5. Deadline Disaster: Oh no! You discover the press release needs to be sent out in only 12 hours, while the rest of the tasks have a two-day deadline.\n\nQuestion : You need to prioritize your tasks. In which order will you tackle them to ensure everything gets done efficiently and effectively?","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":6,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Stock photos and generic captions ","option_id":1,""is_correct":false},{""option":"Funny memes and trendy slang ","option_id":2,""is_correct":false},{""option":"Vibrant product images and creative storytelling ","option_id":3,""is_correct":true},{""option":"Text-heavy posts with detailed product descriptions","option_id":4,""is_correct":false}],""question":"To create engaging social media posts, you decide to utilize:","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":7,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Send a mass email blast with a generic template ","option_id":1,""is_correct":false},{""option":"Personalize each message, highlighting their specific audience and why they\'d be a good fit ","option_id":2,""is_correct":true},{""option":"Offer only free product samples as compensation ","option_id":3,""is_correct":false},{""option":"Demand immediate posts without clear campaign guidelines","option_id":4,""is_correct":false}],""question":"When approaching influencers, you:","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":8,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Use technical jargon and complex language ","option_id":1,""is_correct":false},{""option":"Focus solely on the product\'s ingredients and nutritional facts ","option_id":2,""is_correct":false},{""option":"Craft a catchy headline and emphasize the drink\'s refreshing and fun aspects ","option_id":3,""is_correct":true},{""option":"Include irrelevant information about the company\'s history","option_id":4,""is_correct":false}],""question":"To ensure the press release stands out, you:","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":9,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Panic and rush through the writing, leading to errors and typos ","option_id":1,""is_correct":false},{""option":"Ask your manager for an extension without offering a solution ","option_id":2,""is_correct":false},{""option":"Analyze the key information, prioritize content, and write a concise yet impactful press release ","option_id":3,""is_correct":true},{""option":"Delegate everything to another team member without proper communication","option_id":4,""is_correct":false}],""question":"Faced with the last-minute press release deadline, you:","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":10,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false}]"', '', '1', '', '', '', '15', '10', '90', 'false', 'true', 'true', 'true', 'a2704ce4-4d44-4e9b-bd9c-3a2dd42393c9', 'true', 'true', 'Test'),
	('e59fe20a-271b-466c-a3be-f7cb03f76b33', 'TVET Test 6 (Communication)', 'Duration: 15mins', '[{"type":"Multiple Choice","comment":null,""options":[{""option":"Hold a single information session and expect everyone to be on board. ","option_id":1,""is_correct":false},{""option":"Organize separate meetings for each neighborhood, actively listening to their fears and addressing them directly. ","option_id":2,""is_correct":true},{""option":"Delegate communication to local community leaders without providing clear guidelines. ","option_id":3,""is_correct":false},{""option":"Dismiss their concerns as unfounded and focus solely on the project\'s benefits.","option_id":4,""is_correct":false}],""question":"Scenario 1: Communication \nYou\'re a passionate engineer leading a community project to build a new pedestrian bridge across a bustling river. The goal? Connecting two historically divided neighborhoods and boosting both economic and social interaction. Sounds perfect, right? But before construction can begin, there\'s a mountain of communication to navigate:\n1. Community Concerns: Residents on both sides have mixed feelings. Some are thrilled about the connection, while others worry about increased traffic and potential disruption to their way of life.\n2. Project Team Dynamics: Your diverse team includes skilled architects, passionate community advocates, and budget-conscious contractors. Keeping everyone aligned and motivated can be a challenge.\n3. Stakeholder Scrutiny: Local politicians and business owners have vested interests in the project\'s success. You need to address their concerns and secure their support.\n4. Media Misinformation: An online rumor mill spins out of control, claiming the bridge will harm the environment and displace local businesses. You need to set the record straight and maintain public trust.\n5. Unexpected Discoveries: During construction, your team unearths historical artifacts. This throws a wrench in the schedule and requires delicate discussions with archaeologists and the community.\n\nQuestion 1: How do you address concerns from skeptical residents on both sides of the river?","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":1,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Micromanage every detail and dictate all decisions. ","option_id":1,""is_correct":false},{""option":"Hold regular team meetings with open communication and encourage brainstorming. ","option_id":2,""is_correct":true},{""option":"Rely solely on email updates and avoid open discussions about challenges.","option_id":3,""is_correct":false},{""option":" Create sub-teams without clear communication channels between them.","option_id":4,""is_correct":false}],""question":"Question 2: To keep your project team motivated and working collaboratively, you:","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":2,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Present a polished final plan without considering their input. ","option_id":1,""is_correct":false},{""option":"Actively listen to their concerns and incorporate their feedback where possible. ","option_id":2,""is_correct":true},{""option":"Focus on securing their financial backing without addressing their broader interests. ","option_id":3,""is_correct":false},{""option":"Avoid contact with stakeholders altogether and rely solely on official press releases.","option_id":4,""is_correct":false}],""question":"Question 3: When engaging with stakeholders, your approach is to:","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":3,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Ignore the rumors and hope they fade away on their own. ","option_id":1,""is_correct":false},{""option":"Issue a strongly worded rebuttal without presenting factual evidence. ","option_id":2,""is_correct":false},{""option":"Engage with journalists directly, providing accurate information and clarifying any misconceptions.","option_id":3,""is_correct":true},{""option":"Hire a public relations firm to handle media inquiries without your involvement.","option_id":4,""is_correct":false}],""question":"Question 4: How do you combat the spread of misinformation in the media?","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":4,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Proceed with construction, prioritizing the project timeline over preservation. ","option_id":1,""is_correct":false},{""option":"Shut down the project indefinitely and delay completion indefinitely. ","option_id":2,""is_correct":false},{""option":"Collaborate with archaeologists and community representatives to find a solution that safeguards the artifacts while minimizing disruption. ","option_id":3,""is_correct":true},{""option":" Inform stakeholders only after construction is complete to avoid potential delays.","option_id":4,""is_correct":false}],""question":"Question 5: Upon discovering the historical artifacts, you:","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":5,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Sending an email to community leaders.","option_id":1,""is_correct":false},{""option":"Distributing printed flyers door-to-door.","option_id":2,""is_correct":false},{""option":"Creating a social media event and posting regularly.","option_id":3,""is_correct":false},{""option":"Conducting a town hall meeting.","option_id":4,""is_correct":true}],""question":"Scenario 2: Communication \nYou are leading a community outreach campaign aimed at promoting a local environmental initiative. Effective communication with community members, your project team, and stakeholders is crucial for success. Answer the following multiple-choice questions based on the scenario.\n\nQuestion 1: You need to inform community members about the upcoming initiative. What communication channel would be most effective?","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":6,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Avoid addressing the issue and hope it resolves itself.","option_id":1,""is_correct":false},{""option":"Confront the team publicly about their lack of collaboration.","option_id":2,""is_correct":false},{""option":"Schedule a team-building workshop to address communication and collaboration.","option_id":3,""is_correct":true},{""option":"Assign blame to specific team members for the lack of cohesion.","option_id":4,""is_correct":false}],""question":"Question 2: As the project leader, you notice a lack of cohesion among team members. What is the best approach to address this issue?","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":7,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multi
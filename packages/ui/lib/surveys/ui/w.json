	('b14eb840-625c-46a5-a839-fdbeaea57836', 'TVET Test 11 (Commitment)', 'Duration: 15mins', '[{"type":"Multiple Choice","comment":null,""options":[{""option":"Provide a brief and factual overview of the project goals.","option_id":1,""is_correct":false},{""option":"Share your genuine excitement for the project, emphasizing its potential impact on the community.","option_id":2,""is_correct":true},{""option":"Keep your opinions to yourself, preferring to remain neutral.","option_id":3,""is_correct":false},{""option":"Express concerns about potential challenges the project might face.","option_id":4,""is_correct":false}],""question":"Scenario 1: Passion & Commitment\nYou are a project coordinator for a community empowerment initiative at Harmony Haven. Answer the following multiple-choice questions based on your demonstrated enthusiasm for the project goals and community development.\nQuestion 1: At the project kickoff meeting, you are asked to share your thoughts on the initiative. What is your response?\n\n","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":1,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Send out informational brochures without additional engagement efforts.","option_id":1,""is_correct":false},{""option":"Host a community event to introduce the project, actively encouraging participation and feedback.","option_id":2,""is_correct":true},{""option":"Rely on community leaders to handle engagement without personal involvement.","option_id":3,""is_correct":false},{""option":"Assume the community will naturally support the project without additional outreach.","option_id":4,""is_correct":false}],""question":"The project requires active community involvement. How do you approach engaging community members?","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":2,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Ignore the feedback, assuming it represents a minority opinion.","option_id":1,""is_correct":false},{""option":"Address the concerns openly, expressing a willingness to adapt the project based on community input.","option_id":2,""is_correct":true},{""option":"Discredit the feedback as uninformed or misguided.","option_id":3,""is_correct":false},{""option":"Avoid engaging with the community, fearing further negative feedback.","option_id":4,""is_correct":false}],""question":"Negative feedback arises from a vocal segment of the community. How do you respond?","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":3,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Decline the collaboration, as it might complicate project logistics.","option_id":1,""is_correct":false},{""option":"Express enthusiasm for the collaboration, recognizing the potential for a more significant community impact.","option_id":2,""is_correct":true},{""option":"Defer the decision to higher management without expressing personal opinions.","option_id":3,""is_correct":false},{""option":"Accept the collaboration without consulting the project team.","option_id":4,""is_correct":false}],""question":"Another local organization expresses interest in collaborating on the project. How do you approach this opportunity?","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":4,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Acknowledge the achievement briefly, without additional celebration efforts.","option_id":1,""is_correct":false},{""option":"Organize a community event to celebrate the milestone, involving local residents in the festivities.","option_id":2,""is_correct":true},{""option":"Downplay the milestone to avoid drawing attention.","option_id":3,""is_correct":false},{""option":"Document the achievement but avoid publicizing it to prevent potential backlash.","option_id":4,""is_correct":false}],""question":"The project achieves a significant milestone. How do you celebrate this accomplishment with the community?\n","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":5,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Attend a single town hall meeting and rely on official reports to gather information. ","option_id":1,""is_correct":false},{""option":"Organize workshops and small group discussions to hear diverse perspectives and concerns directly from residents. ","option_id":2,""is_correct":true},{""option":"Focus on attracting corporate investors without considering the impact on local businesses and the environment. ","option_id":3,""is_correct":false},{""option":"Rely solely on online surveys and polls, potentially missing out on deeper community insights.","option_id":4,""is_correct":false}],""question":"Scenario 2: Passion & Commitment\nYou\'ve just joined the board of \""Rosewood Ridge,\"" a charming but aging coastal town struggling to retain its vibrant local spirit and attract eco-conscious tourists. The community is passionate about revitalization, but divided on the best approach.\n\nChallenge: Craft a comprehensive plan that balances economic revival with environmental protection, engaging residents and visitors alike.\n\nQuestion : Your initial approach to understanding the community\'s needs is:","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":6,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Present a pre-defined plan and expect immediate acceptance without open discussion. ","option_id":1,""is_correct":false},{""option":"Actively solicit feedback, incorporating residents\' suggestions and concerns into the plan\'s development. ","option_id":2,""is_correct":true},{""option":"Prioritize financial gain over environmental considerations, potentially facing community backlash. ","option_id":3,""is_correct":false},{""option":"Dismiss traditional local businesses and focus solely on attracting trendy new ventures.","option_id":4,""is_correct":false}],""question":"When proposing revitalization ideas, you:","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":7,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Building large-scale resorts and amusement parks, potentially harming the natural landscape. ","option_id":1,""is_correct":false},{""option":"Promoting responsible tourism practices, highlighting hiking trails, wildlife sanctuaries, and sustainable local businesses. ","option_id":2,""is_correct":true},{""option":"Focusing on luxury amenities and exclusive experiences, excluding budget-conscious travelers and locals. ","option_id":3,""is_correct":false},{""option":"Ignoring environmental concerns and solely emphasizing the town\'s historical charm and cultural attractions.","option_id":4,""is_correct":false}],""question":"To attract eco-conscious tourists, you suggest:","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":8,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Abandon the revitalization plan altogether and avoid further conflict. ","option_id":1,""is_correct":false},{""option":"Engage in respectful dialogue, addressing their concerns and finding common ground for compromise. ","option_id":2,""is_correct":true},{""option":"Dismiss their opposition as outdated and prioritize attracting younger, more modern residents. ","option_id":3,""is_correct":false},{""option":"Force the plan through without seeking consensus, potentially causing resentment and division.","option_id":4,""is_correct":false}],""question":"When facing opposition from some residents who fear change, you:","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":9,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Take sole credit for the success and downplay the community\'s contributions. ","option_id":1,""is_correct":false},{""option":"Express gratitude to the community for their collaboration and celebrate the collective achievement. ","option_id":2,""is_correct":true},{""option":"Use the success to launch personal business ventures without reinvesting in the community\'s development. ","option_id":3,""is_correct":false},{""option":"View it as a stepping stone and propose even more ambitious projects without considering potential unintended consequences.","option_id":4,""is_correct":false}],""question":"The successful implementation of your plan results in increased tourism, thriving local businesses, and a renewed sense of community spirit. Your response is:","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":10,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false}]"', '', '1', '', '', '', '15', '10', '', 'false', 'true', 'true', 'true', 'd240e8a7-b8dc-4532-91e4-1b90ebc83c8d', 'true', 'true', 'Test'),
	('a2704ce4-4d44-4e9b-bd9c-3a2dd42393c9', 'TVET Test 12(Problem Solving)', 'Duration: 15 mins', '[{"type":"Multiple Choice","comment":null,""options":[{""option":"Assume the team will figure it out; no immediate action is necessary.","option_id":1,""is_correct":false},{""option":"Immediately seek external assistance from experts.","option_id":2,""is_correct":false},{""option":"Gather the team for a brainstorming session to identify the root cause.","option_id":3,""is_correct":true},{""option":"Ignore the issue and hope it resolves itself.","option_id":4,""is_correct":false}],""question":"Scenario 1: Innovative Problem-Solving\nYou are a project manager at TechCorp, leading a team in the development of a cutting-edge software application. Answer the following multiple-choice questions based on your ability to identify and address challenges creatively and effectively.\n\nQuestion : Your team faces a sudden technological hurdle that jeopardizes the project timeline. How do you first approach identifying the challenge?","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":1,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Stick to the original plan; the issues will be resolved eventually.","option_id":1,""is_correct":false},{""option":"Rely on tried-and-tested methods used in previous projects.","option_id":2,""is_correct":false},{""option":"Facilitate a collaborative workshop to generate innovative solutions with the team.","option_id":3,""is_correct":true},{""option":"Delegate the problem-solving task to individual team members.","option_id":4,""is_correct":false}],""question":"A critical project component requires a complete overhaul due to unforeseen issues. What approach do you take to find a creative solution?","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":2,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Ignore stakeholder concerns and proceed with the decision.","option_id":1,""is_correct":false},{""option":"Reverse the decision to avoid conflict.","option_id":2,""is_correct":false},{""option":"Engage stakeholders in open communication, considering alternative solutions.","option_id":3,""is_correct":true},{""option":"Overrule stakeholder concerns to maintain project momentum.","option_id":4,""is_correct":false}],""question":"The team encounters resistance from stakeholders on a crucial project decision. How do you navigate this challenge?","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":3,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Assign blame to specific team members responsible for the setback.","option_id":1,""is_correct":false},{""option":"Downplay the setback to avoid demoralizing the team.","option_id":2,""is_correct":false},{""option":"Conduct a retrospective analysis, highlighting lessons learned and areas for improvement.","option_id":3,""is_correct":true},{""option":"Move forward without addressing the setback to maintain team morale.","option_id":4,""is_correct":false}],""question":"A significant project setback occurs due to a miscalculation. How do you ensure the team learns from the experience?","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":4,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":" Ignore the potential risk until it materializes.","option_id":1,""is_correct":false},{""option":"Delegate the task of risk mitigation to a team member.","option_id":2,""is_correct":false},{""option":"Proactively address the risk, engaging the team in preventative measures.","option_id":3,""is_correct":true},{""option":"Develop a contingency plan but keep it private to avoid causing concern.","option_id":4,""is_correct":false}],""question":"Anticipating potential challenges, you notice a potential risk on the horizon. What is your approach?","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":5,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Assume it\'s a known pest and implement standard pest control measures. ","option_id":1,""is_correct":false},{""option":"Ignore the issue, hoping it resolves itself or blaming unknown visitors. ","option_id":2,""is_correct":false},{""option":"Interview park staff and locals, gather evidence, and consult wildlife experts to identify the culprit and develop a targeted solution. ","option_id":3,""is_correct":true},{""option":"Launch a park-wide search party to find the creature, potentially disturbing the ecosystem further.","option_id":4,""is_correct":false}],""question":"Scenario 2: Innovative Problem-Solving\nYou\'re the newly appointed park ranger of \""Whispering Pines,\"" a picturesque nature reserve known for its diverse wildlife and serene woodland trails. But your first week takes a curious turn...\nâ¢\tMysterious Munching: Strange markings appear on trees throughout the park, indicating an unknown creature is feasting on the bark. Your usual suspects, deer and squirrels, are ruled out.\nâ¢\tTrail Troubles: Heavy rains turn previously manageable hiking paths into muddy quagmires, deterring visitors and potentially damaging the delicate ecosystem.\nâ¢\tFunding Famine: Budget cuts mean vital park maintenance projects, like bridge repairs and wildlife observation platforms, are temporarily shelved.\nâ¢\tCommunity Concerns: Anxious locals worry the strange bark munching might signify a larger threat to the park\'s ecosystem. Balancing scientific investigation with public reassurance becomes crucial.\n\nQuestion : How do you approach the mystery of the tree munching?","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":6,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Close the affected trails indefinitely, causing further inconvenience to visitors. ","option_id":1,""is_correct":false},{""option":"Hire additional staff to constantly shovel mud, incurring unsustainable costs. ","option_id":2,""is_correct":false},{""option":"Investigate alternative trail materials or temporary repair solutions, considering budget constraints and environmental impact. ","option_id":3,""is_correct":true},{""option":"Delegate the issue to volunteers without providing clear instructions or resources.","option_id":4,""is_correct":false}],""question":"To tackle the muddy trail problem, you:","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":7,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Accepting donations without a clear plan for their use, leading to potential mismanagement. ","option_id":1,""is_correct":false},{""option":"Reducing park maintenance altogether, jeopardizing safety and visitor experience. ","option_id":2,""is_correct":false},{""option":"Brainstorming creative fundraising initiatives, like crowdfunding campaigns or partnering with local businesses. ","option_id":3,""is_correct":true},{""option":"Lobbying for increased government funding without presenting solutions or data to support your request.","option_id":4,""is_correct":false}],""question":"Facing the funding famine, you consider:","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":8,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Dismiss their worries as unfounded, creating distrust and tension. ","option_id":1,""is_correct":false},{""option":"Issue a generic press release without providing specific information or updates. ","option_id":2,""is_correct":false},{""option":"Organize open forums and presentations, sharing your progress in investigation and solution development, promoting transparency and collaboration. ","option_id":3,""is_correct":true},{""option":"Rely solely on social media posts to communicate, risking misinformation and misinterpretation.","option_id":4,""is_correct":false}],""question":"To address community concerns about the bark munching, you:","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":9,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Panic and react impulsively, potentially worsening the situation. ","option_id":1,""is_correct":false},{""option":"Blame others and avoid taking responsibility for finding solutions.","option_id":2,""is_correct":false},{""option":"Remain calm, assess the situation rationally, and brainstorm creatively to overcome obstacles. ","option_id":3,""is_correct":true},{""option":"Give up easily and abandon any attempts to tackle the challenges.","option_id":4,""is_correct":false}],""question":"When unexpected challenges arise, your approach is:","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":10,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false}]"', '', '1', '', '', '', '15', '10', '90', 'false', 'true', 'true', 'true', 'b14eb840-625c-46a5-a839-fdbeaea57836', 'true', 'true', 'Test'),
	('6f5be9ce-f231-4ace-953c-4197ba802d51', 'TVET Test 8 (Initiative)', 'Duration: 15mins', '[{"type":"Multiple Choice","comment":null,""options":[{""option":"Disregard the trend, as it is not explicitly within your current responsibilities.","option_id":1,""is_correct":false},{""option":"Share the trend with your immediate team and wait for instructions.","option_id":2,""is_correct":false},{""option":" Initiate a discussion with relevant team members, presenting the trend and proposing potential actions.","option_id":3,""is_correct":true},{""option":"Keep the information to yourself, not wanting to step beyond your defined role.","option_id":4,""is_correct":false}],""question":"Scenario 1: Initiative\nYou are an integral member of the Apex Innovations team, a fast-paced technology company. Answer the following multiple-choice questions based on your proactive approach to identifying and taking on additional responsibilities.\n\nQuestion 1: You notice an emerging market trend that aligns with the company\'s goals. What is your immediate action?","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":1,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Wait for someone to assign you tasks.","option_id":1,""is_correct":false},{""option":"Offer to help only with tasks directly related to your role.","option_id":2,""is_correct":false},{""option":"Proactively volunteer to take on additional tasks, contributing to project acceleration.","option_id":3,""is_correct":true},{""option":"Express concerns about your current workload and avoid taking on extra responsibilities.","option_id":4,""is_correct":false}],""question":"A critical project is behind schedule, and additional hands are needed. How do you respond?\n","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":2,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Keep quiet; it\'s not your responsibility to suggest improvements.","option_id":1,""is_correct":false},{""option":"Share your observations with a direct supervisor.","option_id":2,""is_correct":false},{""option":"Collaborate with team members to brainstorm and implement process improvements.","option_id":3,""is_correct":true},{""option":"Wait until the inefficiencies become critical before taking any action.","option_id":4,""is_correct":false}],""question":"You observe inefficiencies in a routine company process. What is your approach to addressing this?","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":3,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Ignore the skills gap and hope for the best.","option_id":1,""is_correct":false},{""option":"Wait for the company to provide training.","option_id":2,""is_correct":false},{""option":"Proactively seek out training opportunities to acquire the necessary skills.","option_id":3,""is_correct":true},{""option":"Delegate tasks requiring the unfamiliar skills to more experienced team members.","option_id":4,""is_correct":false}],""question":"A new project requires skills you don\'t currently possess. How do you handle this situation?","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":4,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Stay silent, assuming someone else will handle it.","option_id":1,""is_correct":false},{""option":"Raise the issue but wait for instructions on how to proceed.","option_id":2,""is_correct":false},{""option":"Take the lead in addressing the issue, proposing solutions and actions.","option_id":3,""is_correct":true},{""option":"Discreetly discuss the issue with a higher-ranking colleague to avoid unnecessary attention.","option_id":4,""is_correct":false}],""question":"During a team meeting, a potential issue is discussed, but no one takes charge. What is your response?","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":5,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Stay silent and assume someone else will fill this gap.","option_id":1,""is_correct":false},{""option":"Express interest in pitching video story ideas and offer to take on production responsibilities. ","option_id":2,""is_correct":true},{""option":"Suggest outsourcing the video content to freelancers, avoiding additional personal workload. ","option_id":3,""is_correct":false},{""option":"Criticize the existing plan without offering constructive alternatives.","option_id":4,""is_correct":false}],""question":"Scenario 2: Initiative\nYou\'re a content creator at Buzzfeed, the internet\'s hub for viral quizzes, listicles, and engaging videos. Today\'s editorial meeting sparks a thrilling brainstorm: launching a week-long campaign highlighting local businesses struggling due to a recent economic downturn.\nThe Challenge: Go beyond typical Buzzfeed fare and create a multi-platform campaign that\'s informative, impactful, and, of course, entertaining! Your team is enthusiastic but stretched thin with existing deadlines.\n\nQuestion 6: As you listen to ideas, you notice a gap in the plan: engaging video stories showcasing the affected businesses. You:","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":6,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Focus solely on the assigned campaign tasks and avoid getting sidetracked by unrelated issues. ","option_id":1,""is_correct":false},{""option":"Propose incorporating a call to action for the food bank within the campaign, potentially boosting community impact. ","option_id":2,""is_correct":true},{""option":"Share the information with colleagues but leave it to them to decide on potential action. ","option_id":3,""is_correct":false},{""option":"Ignore the information as it falls outside the campaign\'s primary scope.","option_id":4,""is_correct":false}],""question":"Researching the campaign, you discover a local food bank facing increased demand due to the hardship. You:","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":7,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Leave the problem-solving to the tech team and continue working on your assigned tasks. ","option_id":1,""is_correct":false},{""option":"Offer your assistance, suggesting alternative platforms or exploring creative workarounds. ","option_id":2,""is_correct":true},{""option":"Point out the potential negativity if the Q&A fails and avoid taking proactive steps. ","option_id":3,""is_correct":false},{""option":"Suggest postponing the campaign altogether to avoid technical glitches.","option_id":4,""is_correct":false}],""question":"During a team meeting, a technical hurdle arises with the planned live Q&A event with local business owners. You:","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":8,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Take credit for the campaign\'s success and avoid mentioning any potential extensions. ","option_id":1,""is_correct":false},{""option":"Express your own satisfaction with the results and leave further efforts to others.","option_id":2,""is_correct":false},{""option":"Draft a proposal for the partnership, highlighting its potential benefits and taking initiative for follow-up. ","option_id":3,""is_correct":true},{""option":"Suggest the idea casually without actively pursuing its implementation.","option_id":4,""is_correct":false}],""question":"The campaign launches successfully, exceeding initial engagement goals. You notice potential for further impact by partnering with a local business school for marketing support. You:","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":9,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Express relief that the campaign is over and focus on returning to routine tasks. ","option_id":1,""is_correct":false},{""option":"Share the feedback with your team, celebrating the collective effort and potential impact. ","option_id":2,""is_correct":false},{""option":"Use the feedback as a springboard for brainstorming future outreach initiatives, demonstrating ongoing commitment. ","option_id":3,""is_correct":true},{""option":"Downplay the impact of the campaign and attribute its success to external factors.","option_id":4,""is_correct":false}],""question":"Weeks after the campaign, you receive positive feedback from both businesses and the food bank. Your response is:","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":10,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false}]"', '', '1', '', '', '', '15', '10', '90', 'false', 'true', 'true', 'true', '9f62bc31-aff4-4a1c-8005-3419fd8794e8', 'true', 'true', 'Test'),
	('0480533a-56c2-4eac-8630-98f501f494f5', 'TVET Test 9 (Leadership II)', 'Duration: 15 minutes ', '[{"type":"Multiple Choice","comment":null,""options":[{""option":"Launch into a passionate speech about environmental threats, potentially overwhelming and demotivating others. ","option_id":1,""is_correct":false},{""option":"Silently plan the festival alone, assuming others will follow your lead without needing inspiration. ","option_id":2,""is_correct":false},{""option":"Hold open brainstorming sessions, inviting diverse community members to share ideas and contribute to the vision. ","option_id":3,""is_correct":true},{""option":"Focus on attracting celebrity guests and sponsors, hoping their presence will automatically revitalize the event.","option_id":4,""is_correct":false}],""question":"Scenario 1: Leadership\nYou\'re a passionate environmentalist living in Green Valley, a picturesque town struggling with pollution and environmental neglect. The annual Green Valley Festival, once a thriving celebration of nature, has dwindled into a half-hearted affair. You dream of revitalizing the festival and inspiring the community to embrace a greener future.\n\nChallenge: Spark renewed enthusiasm for environmental action by transforming the festival into a vibrant, impactful event that motivates residents to get involved.\n\nYour initial approach to galvanizing the community is:","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":1,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Publicly criticize and shame their views, potentially fostering division and resentment. ","option_id":1,""is_correct":false},{""option":"Dismiss their concerns and proceed with your plans, ignoring potential obstacles to community-wide engagement. ","option_id":2,""is_correct":false},{""option":"Engage in respectful dialogue, addressing their concerns and finding common ground through solutions that benefit everyone. ","option_id":3,""is_correct":true},{""option":"Abandon the festival altogether, discouraged by the lack of initial enthusiasm.","option_id":4,""is_correct":false}],""question":"When faced with opposition from some who consider environmentalism \""inconvenient\"" or \""unrealistic,\"" you:","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":2,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Focusing on expensive, large-scale projects that may impress but lack long-term sustainability. ","option_id":1,""is_correct":false},{""option":"Organizing interactive workshops and activities that empower individuals to take small, actionable steps towards green living. ","option_id":2,""is_correct":true},{""option":" Hosting purely symbolic events with minimal practical outcomes, aiming for optics over positive change. ","option_id":3,""is_correct":false},{""option":" Exclude those with limited resources or knowledge, assuming only certain demographics can contribute to environmental action.","option_id":4,""is_correct":false}],""question":"To make the festival impactful, you propose:","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":3,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Panic and blame others, abandoning your leadership role and seeking external solutions. ","option_id":1,""is_correct":false},{""option":"Remain calm and collected, rallying the team to find creative solutions and overcome obstacles collaboratively. ","option_id":2,""is_correct":true},{""option":"Micromanage every aspect of the festival, stifling creativity and iniciativae among community members.","option_id":3,""is_correct":false},{""option":"Delegate tasks haphazardly, expecting everyone to know their roles without clear guidance or communication.","option_id":4,""is_correct":false}],""question":"When challenges arise during the festival\'s planning or execution, you:","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":4,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Take sole credit for the success, downplaying the crucial contributions of the community and team members. ","option_id":1,""is_correct":false},{""option":"Express sincere gratitude to everyone involved, celebrating the collective achievement and motivating further action. ","option_id":2,""is_correct":true},{""option":"Use the success as a platform for self-promotion, seeking personal gain instead of focusing on continued environmental impact. ","option_id":3,""is_correct":false},{""option":"View the festival as a one-time event and abandon further efforts, neglecting the potential for sustained positive change.","option_id":4,""is_correct":false}],""question":"The revitalized Green Valley Festival becomes a resounding success, inspiring residents to adopt sustainable practices and sparking ongoing environmental initiatives. Your response is:","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":5,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Continue with the agenda, assuming enthusiasm will naturally increase.","option_id":1,""is_correct":false},{""option":"Express your own excitement for the project, emphasizing its potential impact.","option_id":2,""is_correct":true},{""option":"Delegate the task of boosting team morale to a more outgoing team member.","option_id":3,""is_correct":false},{""option":"Discuss individual team members\' concerns privately after the meeting.","option_id":4,""is_correct":false}],""question":"Scenario 2: Leadership\nYou are a team leader at Energize Innovations, leading a dynamic group of individuals on a project. Answer the following multiple-choice questions based on your ability to inspire and motivate others, demonstrate initiative, and take on leadership roles when appropriate.\n\nQuestion: At the project kickoff meeting, the team seems hesitant and lacks enthusiasm. How do you address this situation?","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":6,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Assume team members will naturally collaborate without intervention.","option_id":1,""is_correct":false},{""option":"Assign specific roles without considering team members\' strengths.","option_id":2,""is_correct":false},{""option":"Facilitate a collaborative discussion, encouraging team members to share their expertise.","option_id":3,""is_correct":true},{""option":"Let team members decide on collaboration without providing any guidance.","option_id":4,""is_correct":false}],""question":"A complex task requires collaboration between team members with different expertise. How do you encourage collaboration?","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":7,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Seek direction from higher management before taking any action.","option_id":1,""is_correct":false},{""option":"Assign the task of addressing the challenge to a specific team member.","option_id":2,""is_correct":false},{""option":"Proactively lead the team in brainstorming solutions and taking immediate action.","option_id":3,""is_correct":true},{""option":"Ignore the challenge, assuming it will resolve itself.","option_id":4,""is_correct":false}],""question":"The team encounters an unexpected challenge that wasn\'t addressed in the initial plan. How do you approach this challenge?","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":8,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Briefly mention the success without additional recognition efforts.","option_id":1,""is_correct":false},{""option":"Delegate the task of acknowledging achievements to another team member.","option_id":2,""is_correct":false},{""option":"Organize a team celebration, expressing gratitude for everyone\'s hard work.","option_id":3,""is_correct":true},{""option":"Downplay the achievement to avoid overemphasizing success.","option_id":4,""is_correct":false}],""question":"The team successfully completes a challenging phase of the project. How do you acknowledge this achievement?","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":9,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false},{""type":"Multiple Choice","comment":null,""options":[{""option":"Assign the task to the most experienced team member without consulting others.","option_id":1,""is_correct":false},{""option":"Let team members decide among themselves who should take the lead.","option_id":2,""is_correct":false},{""option":"Assess team members\' strengths and delegate the task to the individual best suited for the role.","option_id":3,""is_correct":true},{""option":"Assume the leadership role without considering others\' capabilities.","option_id":4,""is_correct":false}],""question":"A specific project task requires someone to take the lead. How do you decide who should assume this leadership role?","image_url":null,""slider_max":null,""slider_min":null,""is_required":false,""num_ratings":null,""question_id":10,""allow_recording":false,""media_file_type":"Image","slider_interval":1,""allow_multiple_files":false,""allow_multiple_selection":false}]"', '', '1', '', '', '', '15', '10', '90', 'false', 'true', 'true', 'true', '6f5be9ce-f231-4ace-953c-4197ba802d51', 'true', 'true', 'Test'),
